{
  "minimal CMakeLists": {
    "prefix": "cmakemin",
    "body": [
      "cmake_minimum_required(VERSION 3.25)",
      "project(${1:app} LANGUAGES CXX)",
      "",
      "set(CMAKE_CXX_STANDARD 23)",
      "set(CMAKE_CXX_STANDARD_REQUIRED ON)",
      "set(CMAKE_EXPORT_COMPILE_COMMANDS ON)",
      "",
      "add_executable(${1} ${2:src/main.cpp})",
      "target_compile_options(${1} PRIVATE -Wall -Wextra -Wpedantic)$0"
    ]
  }
}
